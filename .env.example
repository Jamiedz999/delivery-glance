# Local development defaults, matching compose.yaml and server/src/main/resources/application.yml.
# Copy to .env and adjust if needed; none of these values are real secrets.

POSTGRES_DB=delivery_glance
POSTGRES_USER=delivery_glance
POSTGRES_PASSWORD=delivery_glance

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/delivery_glance
SPRING_DATASOURCE_USERNAME=delivery_glance
SPRING_DATASOURCE_PASSWORD=delivery_glance

# Session cookies are marked Secure only behind TLS; the local Compose demo serves plain HTTP.
SESSION_COOKIE_SECURE=false

# The Tracking grant cookie defaults to Secure in application.yml, unlike the session cookie above.
# A Tracking Link is a public bearer capability, so the safe default belongs in the application and
# the plain-HTTP demo is what opts out.
TRACKING_COOKIE_SECURE=false
# HMAC key material for Tracking Links. Every link is derived from it, so changing this value
# invalidates every link already issued under version 1. To roll a key without breaking live links,
# add a version 2 key in application.yml and move TRACKING_CURRENT_KEY_VERSION to 2.
TRACKING_KEY_V1=development-only-tracking-key-do-not-deploy
TRACKING_CURRENT_KEY_VERSION=1

# The two fictional pre-provisioned Internal Accounts. Flyway seeds them the first time it runs
# against an empty database, so changing these only affects a fresh volume.
# Password hashes are bcrypt with Spring Security's {id} prefix; generate a replacement with any
# bcrypt tool and keep the prefix.
DEMO_DISPATCHER_EMAIL=dispatcher@delivery-glance.example
DEMO_DISPATCHER_DISPLAY_NAME=Dana the Dispatcher
# Password: Dispatcher-Demo-2026!
DEMO_DISPATCHER_PASSWORD_HASH={bcrypt}$2a$12$48gmvbvPhSdBdq4T2Q90U.B8zYiNnEfN2sHG5LDmdCYkCbXboDQqK
DEMO_COURIER_EMAIL=courier@delivery-glance.example
DEMO_COURIER_DISPLAY_NAME=Cory the Courier
# Password: Courier-Demo-2026!
DEMO_COURIER_PASSWORD_HASH={bcrypt}$2a$12$bYalN1xoO/VQTnYbn6NEPuz3YTktkC.bMYNyKNVlEk9.ga5FfGhg.
