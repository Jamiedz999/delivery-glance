# Local development defaults, matching compose.yaml and server/src/main/resources/application.yml.
# Copy to .env and adjust if needed; none of these values are real secrets.

POSTGRES_DB=delivery_glance
POSTGRES_USER=delivery_glance
POSTGRES_PASSWORD=delivery_glance

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/delivery_glance
SPRING_DATASOURCE_USERNAME=delivery_glance
SPRING_DATASOURCE_PASSWORD=delivery_glance

# Session cookies are marked Secure only behind TLS; the local Compose demo serves plain HTTP.
SESSION_COOKIE_SECURE=false

# The Tracking grant cookie defaults to Secure in application.yml, unlike the session cookie above.
# A Tracking Link is a public bearer capability, so the safe default belongs in the application and
# the plain-HTTP demo is what opts out.
TRACKING_COOKIE_SECURE=false
# HMAC key material for Tracking Links. Every link is derived from it, so changing this value
# invalidates every link already issued under version 1. To roll a key without breaking live links,
# add a version 2 key in application.yml and move TRACKING_CURRENT_KEY_VERSION to 2.
TRACKING_KEY_V1=development-only-tracking-key-do-not-deploy
TRACKING_CURRENT_KEY_VERSION=1

# The map style the Recipient tracking page loads. It is a release input rather than a secret: the
# page also names its origin in the Content-Security-Policy that lets tiles be fetched, so the URL
# has to be absolute. Leaving it empty is a supported deployment — the Recipient view keeps every
# word of its status and freshness content and shows an honest map-unavailable state instead.
TRACKING_MAP_STYLE_URL=

# Who a Recipient is told to contact about a cancelled Delivery. One value for the whole Delivery
# Team, never anything derived from the Delivery. Empty points them back at whoever shared the link.
DELIVERY_TEAM_CONTACT=

# Proof of delivery (Issue 50). Off unless PROOF_BUCKET is set: a blank bucket is a supported
# deployment, /api/system reports it disabled and the Courier is offered no capture. The values below
# turn it on against the LocalStack S3 the Compose `proof` profile starts — run the demo with
# `docker compose --profile proof up --build`. For real AWS, set PROOF_BUCKET and PROOF_REGION,
# leave the endpoint/credentials blank (an instance role signs), and point PROOF_CALLBACK_TOKEN at
# the same secret the deployed Lambda carries.
#
# The endpoint override must be reachable by the *browser*, which uploads directly to S3 — hence
# localhost, mapped to the LocalStack container. The application only signs URLs and never connects
# to S3 itself, so it does not need to resolve this address.
PROOF_BUCKET=
PROOF_REGION=us-east-1
PROOF_ENDPOINT_OVERRIDE=
PROOF_PATH_STYLE_ACCESS=false
PROOF_ACCESS_KEY_ID=
PROOF_SECRET_ACCESS_KEY=
PROOF_PRESIGN_EXPIRY=5m
PROOF_MAX_UPLOAD_BYTES=10485760
PROOF_CALLBACK_TOKEN=

# Off-band Recipient notification (Issue 51). Off unless NOTIFY_QUEUE_URL is set: a blank queue is a
# supported deployment where transitions still write outbox rows for opted-in Recipients but nothing
# relays or sends, and the tracking page's opt-in reports itself unavailable. Turn it on against the
# LocalStack SQS + Lambda + SES/SNS the Compose `notify` overlay starts — run the demo with
# `docker compose -f compose.yaml -f compose.notify.yaml up --build`. For real AWS, set the queue URL
# and region, leave the endpoint/credentials blank (an instance role signs), and point
# NOTIFY_CALLBACK_TOKEN at the same secret the deployed Lambda carries.
#
# Unlike the proof endpoint, the *application* connects to SQS here (the relay sends), so the endpoint
# override must be reachable by the application container, not the browser.
NOTIFY_QUEUE_URL=
NOTIFY_REGION=us-east-1
NOTIFY_ENDPOINT_OVERRIDE=
NOTIFY_ACCESS_KEY_ID=
NOTIFY_SECRET_ACCESS_KEY=
NOTIFY_RELAY_BATCH_SIZE=50
NOTIFY_RELAY_INTERVAL=PT5S
NOTIFY_CALLBACK_TOKEN=

# Whether POST /api/demo/reset exists. It empties every Delivery, Assignment, Tracking Link and
# Courier fact and recreates the fictional Deliveries the demo walkthrough starts from, so it is a
# deliberate destruction of all fulfilment data. Off here and off by default in the application:
# with it off the route is refused by the security policy, not merely unmapped. Turn it on only for
# a deployment whose every row is fictional — the public portfolio demo is the intended one.
DEMO_RESET_ENABLED=false

# How often the demo puts itself back to the walkthrough's starting state, as a Spring cron
# expression (second minute hour day month weekday). Blank is no schedule and is right for a local
# demo: it changes only when you drive it, and `docker compose down -v` is the stronger reset you
# already have. Set it alongside the switch above on a public demo, where visitors leave the board
# in whatever state they reached, and off-peak — a reset mid-walkthrough is a recording ruined.
# With a schedule set the demo also seeds itself once at startup, so a fresh deployment is never an
# empty board. Example, 04:00 UTC daily: 0 0 4 * * *
DEMO_RESET_SCHEDULE=

# The two fictional pre-provisioned Internal Accounts. Flyway seeds them the first time it runs
# against an empty database, so changing these only affects a fresh volume.
# Password hashes are bcrypt with Spring Security's {id} prefix; generate a replacement with any
# bcrypt tool and keep the prefix.
DEMO_DISPATCHER_EMAIL=dispatcher@delivery-glance.example
DEMO_DISPATCHER_DISPLAY_NAME=Dana the Dispatcher
# Password: Dispatcher-Demo-2026!
DEMO_DISPATCHER_PASSWORD_HASH={bcrypt}$2a$12$48gmvbvPhSdBdq4T2Q90U.B8zYiNnEfN2sHG5LDmdCYkCbXboDQqK
DEMO_COURIER_EMAIL=courier@delivery-glance.example
DEMO_COURIER_DISPLAY_NAME=Cory the Courier
# Password: Courier-Demo-2026!
DEMO_COURIER_PASSWORD_HASH={bcrypt}$2a$12$bYalN1xoO/VQTnYbn6NEPuz3YTktkC.bMYNyKNVlEk9.ga5FfGhg.
